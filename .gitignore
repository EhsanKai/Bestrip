# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Agent/orchestration runtime state. Never belongs in the repository.
#
# Scoped deliberately wide: an audit of this tree found 371 of 383 untracked
# paths were agent runtime state, including live SQLite databases, and the
# previous rules covered none of them. A partial ignore list is worse than
# none, because it reads as protection.
.agents/
.claude/
.claude-flow/
.codex/
.swarm/
.mcp.json
ruvector.db
detoura.db
*.db-shm
*.db-wal

# Local build artifact — a 26MB zip of the client bundle, not a source input.
frontend.zip

# V9 Phase 2.6 Part B: destination-image acquisition scratch. The pipeline
# processes downloads in memory and never writes a raw original to disk, but
# these are reserved for any future cache/debug use so one is never
# accidentally committed. The manifest and optimized data/destination_images/
# assets/*.webp ARE committed - they are the actual product, not scratch.
data/destination_images/originals/
data/destination_images/cache/
data/destination_images/reports/
